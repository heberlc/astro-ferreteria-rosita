---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/common/Header.astro";
import Footer from "../../components/common/Footer.astro";
import ProductCard from "../../components/catalog/ProductCard.astro";
import FilterSidebar from "../../components/catalog/FilterSidebar.astro";
import { getCollection } from "astro:content";

// Get category from URL params
const url = new URL(Astro.request.url);
const categoryFilter = url.searchParams.get("category");

// Get all products
let products = await getCollection("products");

// Filter by category if specified
if (categoryFilter) {
  products = products.filter((p) => p.data.category === categoryFilter);
}

const categoryTitle = categoryFilter
  ? categoryFilter.charAt(0).toUpperCase() + categoryFilter.slice(1)
  : "Todos los Productos";
---

<Layout title={`${categoryTitle} | Ferretería Rosita`}>
  <Header />

  <main class="pt-20">
    <div
      class="flex px-6 md:px-10 lg:px-16 py-8 max-w-[1600px] w-full mx-auto gap-8"
    >
      <!-- Sidebar -->
      <FilterSidebar currentCategory={categoryFilter} />

      <!-- Main Content -->
      <div class="flex-1 flex flex-col min-w-0">
        <!-- Breadcrumbs -->
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <a
            href="/"
            class="text-text-secondary hover:text-white transition-colors text-sm font-medium"
            >Inicio</a
          >
          <span class="material-symbols-outlined text-text-secondary text-base"
            >chevron_right</span
          >
          <a
            href="/catalogo"
            class="text-text-secondary hover:text-white transition-colors text-sm font-medium"
            >Catálogo</a
          >
          {
            categoryFilter && (
              <>
                <span class="material-symbols-outlined text-text-secondary text-base">
                  chevron_right
                </span>
                <span class="text-primary text-sm font-medium">
                  {categoryTitle}
                </span>
              </>
            )
          }
        </div>

        <!-- Page Header -->
        <div
          class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 border-b border-border-dark pb-6"
        >
          <div>
            <h1
              class="text-white text-3xl md:text-4xl font-bold tracking-tight mb-2"
            >
              {categoryTitle}
            </h1>
            <p id="product-count" class="text-text-secondary text-sm">
              Mostrando {products.length} productos
            </p>
          </div>
          <div class="flex items-center gap-3">
            <!-- Sort Dropdown -->
            <div class="relative" id="sort-container">
              <button
                id="sort-button"
                class="flex items-center gap-2 bg-surface-dark border border-border-dark text-white px-4 py-2 rounded-lg text-sm font-medium hover:border-text-secondary transition-colors"
              >
                <span class="material-symbols-outlined text-lg">sort</span>
                <span id="sort-label">Ordenar</span>
                <span
                  class="material-symbols-outlined text-lg transition-transform"
                  id="sort-arrow">expand_more</span
                >
              </button>
              <!-- Dropdown Menu -->
              <div
                id="sort-dropdown"
                class="absolute right-0 top-full mt-2 w-48 bg-surface-dark border border-border-dark rounded-lg shadow-xl z-50 hidden"
              >
                <button
                  data-sort="default"
                  class="sort-option w-full text-left px-4 py-2.5 text-sm text-white hover:bg-border-dark transition-colors rounded-t-lg"
                >
                  Predeterminado
                </button>
                <button
                  data-sort="price-asc"
                  class="sort-option w-full text-left px-4 py-2.5 text-sm text-text-secondary hover:text-white hover:bg-border-dark transition-colors"
                >
                  Precio: Menor a Mayor
                </button>
                <button
                  data-sort="price-desc"
                  class="sort-option w-full text-left px-4 py-2.5 text-sm text-text-secondary hover:text-white hover:bg-border-dark transition-colors"
                >
                  Precio: Mayor a Menor
                </button>
                <button
                  data-sort="name-asc"
                  class="sort-option w-full text-left px-4 py-2.5 text-sm text-text-secondary hover:text-white hover:bg-border-dark transition-colors"
                >
                  Nombre: A - Z
                </button>
                <button
                  data-sort="name-desc"
                  class="sort-option w-full text-left px-4 py-2.5 text-sm text-text-secondary hover:text-white hover:bg-border-dark transition-colors rounded-b-lg"
                >
                  Nombre: Z - A
                </button>
              </div>
            </div>
            <!-- View Toggle -->
            <div
              class="flex bg-surface-dark rounded-lg p-1 border border-border-dark"
              id="view-toggle"
            >
              <button
                id="view-grid"
                class="p-1.5 rounded bg-border-dark text-white shadow-sm transition-colors"
              >
                <span class="material-symbols-outlined text-xl">grid_view</span>
              </button>
              <button
                id="view-list"
                class="p-1.5 rounded text-text-secondary hover:text-white hover:bg-border-dark/50 transition-colors"
              >
                <span class="material-symbols-outlined text-xl">view_list</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Product Grid -->
        {
          products.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 2xl:grid-cols-4 gap-6">
              {products.map((product) => (
                <ProductCard
                  title={product.data.title}
                  slug={product.data.slug}
                  brand={product.data.brand}
                  price={product.data.price}
                  originalPrice={product.data.originalPrice}
                  image={product.data.image}
                  category={product.data.category}
                  isNew={product.data.isNew}
                  discount={product.data.discount}
                  stock={product.data.stock}
                />
              ))}
            </div>
          ) : (
            <div class="text-center py-20">
              <span class="material-symbols-outlined text-6xl text-text-muted mb-4">
                inventory_2
              </span>
              <h3 class="text-white text-xl font-bold mb-2">
                No hay productos
              </h3>
              <p class="text-text-secondary">
                No se encontraron productos en esta categoría.
              </p>
              <a
                href="/catalogo"
                class="inline-flex items-center gap-2 mt-4 text-primary hover:text-primary-hover transition-colors"
              >
                Ver todos los productos
                <span class="material-symbols-outlined">arrow_forward</span>
              </a>
            </div>
          )
        }

        <!-- Pagination -->
        {
          products.length > 0 && (
            <div class="flex justify-center mt-12 mb-8">
              <nav class="flex items-center gap-2">
                <button class="flex items-center justify-center size-10 rounded-lg border border-border-dark bg-surface-dark text-text-secondary hover:text-white hover:border-text-secondary transition-all">
                  <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <button class="flex items-center justify-center size-10 rounded-lg border border-primary bg-primary text-white font-bold shadow-lg shadow-primary/20">
                  1
                </button>
                <button class="flex items-center justify-center size-10 rounded-lg border border-border-dark bg-surface-dark text-text-secondary hover:text-white hover:border-text-secondary transition-all">
                  2
                </button>
                <button class="flex items-center justify-center size-10 rounded-lg border border-border-dark bg-surface-dark text-text-secondary hover:text-white hover:border-text-secondary transition-all">
                  <span class="material-symbols-outlined">chevron_right</span>
                </button>
              </nav>
            </div>
          )
        }
      </div>
    </div>
  </main>

  <Footer />

  <script>
    // Sort dropdown functionality
    const sortButton = document.getElementById("sort-button");
    const sortDropdown = document.getElementById("sort-dropdown");
    const sortArrow = document.getElementById("sort-arrow");
    const sortLabel = document.getElementById("sort-label");
    const sortOptions = document.querySelectorAll(".sort-option");

    // Toggle dropdown
    sortButton?.addEventListener("click", () => {
      const isOpen = !sortDropdown?.classList.contains("hidden");
      sortDropdown?.classList.toggle("hidden");
      sortArrow?.classList.toggle("rotate-180");
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
      if (
        !document.getElementById("sort-container")?.contains(e.target as Node)
      ) {
        sortDropdown?.classList.add("hidden");
        sortArrow?.classList.remove("rotate-180");
      }
    });

    // Sort products
    sortOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const sortType = (option as HTMLElement).dataset.sort;
        const productGrid =
          document.querySelector("[data-product]")?.parentElement;
        if (!productGrid) return;

        const products = Array.from(
          productGrid.querySelectorAll<HTMLElement>("[data-product]")
        );

        // Get original order if not stored
        if (!productGrid.dataset.originalOrder) {
          productGrid.dataset.originalOrder = products
            .map((p) => p.dataset.product)
            .join(",");
        }

        // Sort based on type
        let sortedProducts: HTMLElement[];
        switch (sortType) {
          case "price-asc":
            sortedProducts = products.sort(
              (a, b) =>
                parseFloat(a.dataset.price || "0") -
                parseFloat(b.dataset.price || "0")
            );
            break;
          case "price-desc":
            sortedProducts = products.sort(
              (a, b) =>
                parseFloat(b.dataset.price || "0") -
                parseFloat(a.dataset.price || "0")
            );
            break;
          case "name-asc":
            sortedProducts = products.sort((a, b) =>
              (a.dataset.product || "").localeCompare(b.dataset.product || "")
            );
            break;
          case "name-desc":
            sortedProducts = products.sort((a, b) =>
              (b.dataset.product || "").localeCompare(a.dataset.product || "")
            );
            break;
          default:
            // Restore original order
            const originalOrder =
              productGrid.dataset.originalOrder?.split(",") || [];
            sortedProducts = products.sort(
              (a, b) =>
                originalOrder.indexOf(a.dataset.product || "") -
                originalOrder.indexOf(b.dataset.product || "")
            );
        }

        // Re-append sorted products
        sortedProducts.forEach((product) => productGrid.appendChild(product));

        // Update button label
        const labels: Record<string, string> = {
          default: "Ordenar",
          "price-asc": "Menor precio",
          "price-desc": "Mayor precio",
          "name-asc": "A - Z",
          "name-desc": "Z - A",
        };
        if (sortLabel) sortLabel.textContent = labels[sortType || "default"];

        // Update active state
        sortOptions.forEach((opt) => {
          opt.classList.remove("text-white");
          opt.classList.add("text-text-secondary");
        });
        option.classList.add("text-white");
        option.classList.remove("text-text-secondary");

        // Close dropdown
        sortDropdown?.classList.add("hidden");
        sortArrow?.classList.remove("rotate-180");
      });
    });

    // View toggle functionality
    const viewGrid = document.getElementById("view-grid");
    const viewList = document.getElementById("view-list");
    const productContainer =
      document.querySelector("[data-product]")?.parentElement;

    function setActiveView(activeBtn: HTMLElement, inactiveBtn: HTMLElement) {
      activeBtn.classList.add("bg-border-dark", "text-white", "shadow-sm");
      activeBtn.classList.remove("text-text-secondary");
      inactiveBtn.classList.remove("bg-border-dark", "text-white", "shadow-sm");
      inactiveBtn.classList.add("text-text-secondary");
    }

    viewGrid?.addEventListener("click", () => {
      if (!productContainer || !viewList) return;
      productContainer.classList.remove("grid-cols-1", "gap-4");
      productContainer.classList.add(
        "grid-cols-1",
        "sm:grid-cols-2",
        "lg:grid-cols-3",
        "xl:grid-cols-3",
        "2xl:grid-cols-4",
        "gap-6"
      );

      // Reset cards to grid view
      productContainer.querySelectorAll("[data-product]").forEach((card) => {
        card.classList.remove("flex-row", "max-h-48");
        card.classList.add("flex-col");
      });

      setActiveView(viewGrid, viewList);
    });

    viewList?.addEventListener("click", () => {
      if (!productContainer || !viewGrid) return;
      productContainer.classList.remove(
        "sm:grid-cols-2",
        "lg:grid-cols-3",
        "xl:grid-cols-3",
        "2xl:grid-cols-4",
        "gap-6"
      );
      productContainer.classList.add("grid-cols-1", "gap-4");

      // Adjust cards to list view
      productContainer.querySelectorAll("[data-product]").forEach((card) => {
        card.classList.add("flex-row", "max-h-48");
        card.classList.remove("flex-col");
      });

      setActiveView(viewList, viewGrid);
    });
  </script>
</Layout>

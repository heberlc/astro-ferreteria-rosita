---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/common/Header.astro";
import Footer from "../../components/common/Footer.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { FEATURES } from "../../config/site";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.id }, // Usar el ID del archivo como slug
    props: { product },
  }));
}

const { product } = Astro.props;
const {
  title,
  brand,
  price,
  originalPrice,
  image,
  description,
  features,
  category,
  variants,
} = product.data;

// Determinar precio a mostrar (variante mínima o precio base)
const hasVariants = variants && variants.length > 0;
const displayPrice = hasVariants
  ? Math.min(...variants.map((v: { price: number }) => v.price))
  : price;
const defaultVariant = hasVariants ? variants[0] : null;

// Helper para generar SKU automáticamente
function generateSku(productId: string, variantName: string): string {
  return `${productId}-${variantName
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/-+$/, "")}`;
}
const defaultSku = defaultVariant
  ? generateSku(product.id, defaultVariant.name)
  : product.id;

const categoryNames: Record<string, string> = {
  construccion: "Construcción",
  gasfiteria: "Gasfitería",
  electricidad: "Electricidad",
  pinturas: "Pinturas",
  ferreteria: "Ferretería",
  ceramicos: "Cerámicos",
};
---

<Layout title={`${title} | Ferretería Rosita`}>
  <Header />

  <main class="pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumbs -->
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <a
          href="/"
          class="text-text-secondary hover:text-white transition-colors text-sm font-medium"
          >Inicio</a
        >
        <span class="material-symbols-outlined text-text-secondary text-base"
          >chevron_right</span
        >
        <a
          href="/catalogo"
          class="text-text-secondary hover:text-white transition-colors text-sm font-medium"
          >Catálogo</a
        >
        <span class="material-symbols-outlined text-text-secondary text-base"
          >chevron_right</span
        >
        <a
          href={`/catalogo?category=${category}`}
          class="text-text-secondary hover:text-white transition-colors text-sm font-medium"
        >
          {categoryNames[category] || category}
        </a>
        <span class="material-symbols-outlined text-text-secondary text-base"
          >chevron_right</span
        >
        <span class="text-primary text-sm font-medium line-clamp-1"
          >{title}</span
        >
      </div>

      <!-- Product Detail -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Image -->
        <div
          class="bg-surface-dark rounded-2xl p-8 flex items-center justify-center"
        >
          {
            typeof image !== "string" ? (
              <Image
                src={image as ImageMetadata}
                alt={title}
                width={600}
                height={600}
                class="max-h-[500px] object-contain"
              />
            ) : (
              <img
                src={image}
                alt={title}
                class="max-h-[500px] object-contain"
              />
            )
          }
        </div>

        <!-- Info -->
        <div class="flex flex-col">
          <p class="text-text-secondary text-sm mb-2">{brand}</p>
          <h1 class="text-white text-3xl md:text-4xl font-bold mb-4">
            {title}
          </h1>

          <!-- Rating -->
          {
            FEATURES.showProductReviews && (
              <div class="flex items-center gap-2 mb-6">
                <div class="flex text-yellow-500">
                  <span class="material-symbols-outlined">star</span>
                  <span class="material-symbols-outlined">star</span>
                  <span class="material-symbols-outlined">star</span>
                  <span class="material-symbols-outlined">star</span>
                  <span class="material-symbols-outlined text-text-muted">
                    star_border
                  </span>
                </div>
                <span class="text-text-secondary text-sm">(12 reseñas)</span>
              </div>
            )
          }

          <!-- Variant Selector -->
          {
            hasVariants && (
              <div class="mb-6">
                <label class="block text-white font-medium mb-2">
                  Presentación:
                </label>
                <select
                  id="variant-selector"
                  class="w-full sm:w-auto px-4 py-3 bg-surface-dark border border-border rounded-lg text-white focus:border-primary focus:outline-none"
                >
                  {variants.map((variant: { name: string; price: number }) => (
                    <option
                      value={generateSku(product.id, variant.name)}
                      data-price={variant.price}
                      data-name={variant.name}
                    >
                      {variant.name} - S/{variant.price.toFixed(2)}
                    </option>
                  ))}
                </select>
              </div>
            )
          }

          <!-- Price -->
          <div class="flex items-baseline gap-3 mb-6">
            {
              displayPrice ? (
                <>
                  {hasVariants && (
                    <span class="text-text-secondary text-lg">Precio:</span>
                  )}
                  <span
                    id="price-display"
                    class="text-4xl font-bold text-primary"
                  >
                    S/{displayPrice.toFixed(2)}
                  </span>
                  {originalPrice && (
                    <span class="text-xl text-text-muted line-through">
                      S/{originalPrice.toFixed(2)}
                    </span>
                  )}
                </>
              ) : (
                <span class="text-xl text-text-secondary">
                  Consultar precio
                </span>
              )
            }
          </div>

          <!-- Description -->
          {
            description && (
              <p class="text-text-secondary leading-relaxed mb-6">
                {description}
              </p>
            )
          }

          <!-- Features -->
          {
            features && features.length > 0 && (
              <div class="mb-8">
                <h3 class="text-white font-bold mb-3">Características:</h3>
                <ul class="space-y-2">
                  {features.map((feature: string) => (
                    <li class="flex items-center gap-2 text-text-secondary">
                      <span class="material-symbols-outlined text-primary text-sm">
                        check_circle
                      </span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 mt-auto">
            <button
              id="add-to-cart-btn"
              data-product-id={product.id}
              data-title={title}
              data-brand={brand}
              data-price={defaultVariant?.price || price || 0}
              data-sku={defaultSku}
              data-variant={defaultVariant?.name || ""}
              data-image={typeof image !== "string" ? image.src : image}
              class="flex-1 py-4 px-8 rounded-lg bg-primary hover:bg-primary-hover text-white font-bold transition-all shadow-lg shadow-primary/25 flex items-center justify-center gap-3"
            >
              <span class="material-symbols-outlined">add_shopping_cart</span>
              Agregar al Carrito
            </button>
            <button
              id="whatsapp-btn"
              data-title={title}
              data-brand={brand}
              data-price={defaultVariant?.price || price || 0}
              data-sku={defaultSku}
              data-variant={defaultVariant?.name || ""}
              class="flex-1 py-4 px-8 rounded-lg bg-green-600 hover:bg-green-700 text-white font-bold transition-all flex items-center justify-center gap-3"
            >
              <span class="material-symbols-outlined">chat</span>
              WhatsApp
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    import { addToCart } from "../../lib/cart";

    // Variant selector logic
    const variantSelector = document.getElementById(
      "variant-selector"
    ) as HTMLSelectElement;
    const priceDisplay = document.getElementById("price-display");
    const addToCartBtn = document.getElementById("add-to-cart-btn");
    const whatsappBtn = document.getElementById("whatsapp-btn");

    if (variantSelector) {
      variantSelector.addEventListener("change", () => {
        const selectedOption =
          variantSelector.options[variantSelector.selectedIndex];
        const price = parseFloat(selectedOption.dataset.price || "0");
        const sku = selectedOption.value;
        const variantName = selectedOption.dataset.name || "";

        // Update price display
        if (priceDisplay) {
          priceDisplay.textContent = `S/${price.toFixed(2)}`;
        }

        // Update button data attributes
        if (addToCartBtn) {
          addToCartBtn.dataset.price = price.toString();
          addToCartBtn.dataset.sku = sku;
          addToCartBtn.dataset.variant = variantName;
        }
        if (whatsappBtn) {
          whatsappBtn.dataset.price = price.toString();
          whatsappBtn.dataset.sku = sku;
          whatsappBtn.dataset.variant = variantName;
        }
      });
    }

    // Add to Cart button
    addToCartBtn?.addEventListener("click", () => {
      const productId = addToCartBtn.dataset.productId || "";
      const title = addToCartBtn.dataset.title || "";
      const brand = addToCartBtn.dataset.brand || "";
      const price = parseFloat(addToCartBtn.dataset.price || "0");
      const image = addToCartBtn.dataset.image || "";
      const sku = addToCartBtn.dataset.sku || "";
      const variant = addToCartBtn.dataset.variant || "";

      addToCart({
        slug: sku, // Usar SKU como identificador único
        title: variant ? `${title} - ${variant}` : title,
        brand: brand,
        price: price,
        image: image,
      });

      // Visual feedback
      const originalText = addToCartBtn.innerHTML;
      addToCartBtn.innerHTML = `<span class="material-symbols-outlined">check</span> ¡Agregado!`;
      addToCartBtn.classList.add("bg-green-600");
      addToCartBtn.classList.remove("bg-primary", "hover:bg-primary-hover");

      setTimeout(() => {
        addToCartBtn.innerHTML = originalText;
        addToCartBtn.classList.remove("bg-green-600");
        addToCartBtn.classList.add("bg-primary", "hover:bg-primary-hover");
      }, 2000);
    });

    // WhatsApp button - direct product inquiry
    whatsappBtn?.addEventListener("click", () => {
      const title = whatsappBtn.dataset.title || "";
      const brand = whatsappBtn.dataset.brand || "";
      const price = parseFloat(whatsappBtn.dataset.price || "0");
      const sku = whatsappBtn.dataset.sku || "";
      const variant = whatsappBtn.dataset.variant || "";

      const productName = variant ? `${title} - ${variant}` : title;
      const message =
        `¡Hola! Me interesa el siguiente producto:\n\n` +
        `📦 *${productName}*\n` +
        `🏷️ Marca: ${brand}\n` +
        (price > 0 ? `💰 Precio: S/${price.toFixed(2)}\n` : "") +
        `🔗 Código: ${sku}\n\n` +
        `¿Podrían darme más información?`;

      const phoneNumber = "51999999999"; // Replace with actual number
      const encodedMessage = encodeURIComponent(message);
      window.open(
        `https://wa.me/${phoneNumber}?text=${encodedMessage}`,
        "_blank"
      );
    });
  </script>
</Layout>

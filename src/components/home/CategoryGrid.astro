---
/**
 * Category Grid Component
 * Display featured product categories from Content Collections
 */
import { getCollection } from 'astro:content';

// Get categories from Content Collections
const categoriesData = await getCollection('categories');

// Sort by order and take first 4 for homepage
const categories = categoriesData
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .slice(0, 4);
---

<section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- Header -->
  <div class="flex items-end justify-between mb-10">
    <div>
      <h2 class="text-3xl font-bold text-white mb-2">Categorías Destacadas</h2>
      <p class="text-text-secondary">Encuentra exactamente lo que buscas por departamento</p>
    </div>
    <a href="/catalogo" class="hidden sm:flex items-center gap-1 text-primary hover:text-primary-hover font-medium transition-colors">
      Ver todas
      <span class="material-symbols-outlined text-sm">arrow_forward_ios</span>
    </a>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {categories.map((category) => (
      <a 
        href={`/catalogo?category=${category.data.slug}`}
        class="group relative overflow-hidden rounded-2xl aspect-4/5 bg-surface-dark border border-white/5 shadow-xl transition-all hover:border-primary/50"
      >
        <!-- Background Image -->
        <div 
          class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
          style={`background-image: url('${category.data.image}');`}
        ></div>
        
        <!-- Gradient Overlay -->
        <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-transparent"></div>
        
        <!-- Content -->
        <div class="absolute bottom-0 left-0 p-6 w-full">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/10 backdrop-blur-md mb-3 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
            <span class="material-symbols-outlined">{category.data.icon}</span>
          </span>
          <h3 class="text-xl font-bold text-white mb-1 group-hover:translate-x-1 transition-transform">{category.data.title}</h3>
          <p class="text-sm text-text-secondary line-clamp-2">{category.data.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

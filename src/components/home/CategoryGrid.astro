---
/**
 * Category Grid Component
 * Display featured product categories in a visual grid
 */

interface Category {
  title: string;
  description: string;
  icon: string;
  image: string;
  href: string;
}

const categories: Category[] = [
  {
    title: "Construcción",
    description: "Cementos, ladrillos y acabados.",
    icon: "foundation",
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=600&q=80",
    href: "/catalogo?category=construccion"
  },
  {
    title: "Gasfitería",
    description: "Tuberías, grifos y accesorios.",
    icon: "plumbing",
    image: "https://images.unsplash.com/photo-1585704032915-c3400ca199e7?w=600&q=80",
    href: "/catalogo?category=gasfiteria"
  },
  {
    title: "Electricidad",
    description: "Cables, iluminación y tableros.",
    icon: "bolt",
    image: "https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=600&q=80",
    href: "/catalogo?category=electricidad"
  },
  {
    title: "Ferretería",
    description: "Herramientas y cerrajería.",
    icon: "home_repair_service",
    image: "https://images.unsplash.com/photo-1530124566582-a618bc2615dc?w=600&q=80",
    href: "/catalogo?category=ferreteria"
  }
];
---

<section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- Header -->
  <div class="flex items-end justify-between mb-10">
    <div>
      <h2 class="text-3xl font-bold text-white mb-2">Categorías Destacadas</h2>
      <p class="text-text-secondary">Encuentra exactamente lo que buscas por departamento</p>
    </div>
    <a href="/catalogo" class="hidden sm:flex items-center gap-1 text-primary hover:text-primary-hover font-medium transition-colors">
      Ver todas
      <span class="material-symbols-outlined text-sm">arrow_forward_ios</span>
    </a>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {categories.map((category) => (
      <a 
        href={category.href}
        class="group relative overflow-hidden rounded-2xl aspect-[4/5] bg-surface-dark border border-white/5 shadow-xl transition-all hover:border-primary/50"
      >
        <!-- Background Image -->
        <div 
          class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
          style={`background-image: url('${category.image}');`}
        ></div>
        
        <!-- Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
        
        <!-- Content -->
        <div class="absolute bottom-0 left-0 p-6 w-full">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/10 backdrop-blur-md mb-3 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
            <span class="material-symbols-outlined">{category.icon}</span>
          </span>
          <h3 class="text-xl font-bold text-white mb-1 group-hover:translate-x-1 transition-transform">{category.title}</h3>
          <p class="text-sm text-text-secondary line-clamp-2">{category.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

---
/**
 * Featured Products Component
 * Showcase products marked as featured from Content Collections
 */
import { getCollection } from 'astro:content';

// Get featured products from Content Collections
const allProducts = await getCollection('products');
const featuredProducts = allProducts
  .filter(p => p.data.featured)
  .slice(0, 4);

function renderStars(rating: number) {
  const fullStars = Math.floor(rating);
  const hasHalf = rating % 1 >= 0.5;
  const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
  return { fullStars, hasHalf, emptyStars };
}
---

<section class="py-20 bg-surface-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-3xl font-bold text-white">Productos Populares</h2>
      <a href="/catalogo" class="flex items-center gap-1 text-primary hover:text-primary-hover font-medium transition-colors">
        Ver todos
        <span class="material-symbols-outlined text-sm">arrow_forward_ios</span>
      </a>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {featuredProducts.map((product) => {
        const { title, brand, price, originalPrice, image, discount, isNew, rating = 0, reviewCount = 0 } = product.data;
        const stars = renderStars(rating);
        const badge = discount ? `-${discount}% OFF` : isNew ? 'NUEVO' : null;
        const badgeColor = discount ? 'bg-red-600' : 'bg-green-500';
        
        // Handle both local images (ImageMetadata) and external URLs (string)
        const imageSrc = typeof image === 'string' ? image : image.src;
        
        return (
          <a href={`/catalogo/${product.data.slug}`} class="group bg-surface-elevated rounded-xl overflow-hidden border border-white/5 hover:border-primary/30 transition-all hover:shadow-xl hover:shadow-black/50">
            <!-- Image -->
            <div class="relative aspect-square overflow-hidden bg-white/5 p-4 flex items-center justify-center">
              {badge && (
                <div class={`absolute top-3 left-3 z-10 ${badgeColor} text-white text-xs font-bold px-2 py-1 rounded`}>
                  {badge}
                </div>
              )}
              <img 
                src={imageSrc} 
                alt={title}
                class="object-contain h-full w-full group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
              />
            </div>

            <!-- Info -->
            <div class="p-5">
              <p class="text-sm text-text-secondary mb-1">{brand}</p>
              <h3 class="text-white font-semibold text-lg mb-2 line-clamp-2">{title}</h3>
              
              <div class="flex items-center justify-between mt-4">
                <div>
                  {price ? (
                    <>
                      <span class="text-2xl font-bold text-primary">S/{price.toFixed(2)}</span>
                      {originalPrice && (
                        <span class="text-sm text-text-muted line-through ml-2">S/{originalPrice.toFixed(2)}</span>
                      )}
                    </>
                  ) : (
                    <span class="text-text-secondary">Consultar</span>
                  )}
                </div>
                <div class="flex text-yellow-500 text-sm">
                  {Array.from({ length: stars.fullStars }).map(() => (
                    <span class="material-symbols-outlined text-base">star</span>
                  ))}
                  {stars.hasHalf && (
                    <span class="material-symbols-outlined text-base">star_half</span>
                  )}
                  {Array.from({ length: stars.emptyStars }).map(() => (
                    <span class="material-symbols-outlined text-base text-text-muted">star_border</span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

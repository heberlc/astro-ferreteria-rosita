---
/**
 * Hero Section Component
 * Full-width hero with gradient overlay and CTA
 */
---

<section
  class="relative h-[600px] w-full flex items-center justify-center overflow-hidden"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <div
      class="absolute inset-0 bg-gradient-to-r from-background-dark via-background-dark/80 to-transparent z-10"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-background-dark via-transparent to-background-dark/40 z-10"
    >
    </div>
    <div
      class="w-full h-full bg-cover bg-center"
      style="background-image: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&q=80');"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-2xl flex flex-col gap-6">
      <!-- Badge -->
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/20 border border-primary/30 w-fit backdrop-blur-sm"
      >
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="text-primary text-xs font-bold uppercase tracking-wider"
          >Líderes en Materiales</span
        >
      </div>

      <!-- Heading -->
      <h1
        class="text-5xl md:text-6xl font-black text-white leading-[1.1] tracking-tight"
      >
        Soluciones <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-orange-400"
          >Confiables</span
        > para tu Proyecto
      </h1>

      <!-- Description -->
      <p class="text-lg text-text-secondary max-w-lg leading-relaxed">
        Todo lo que necesitas para construir, reparar y mejorar con la mejor
        calidad del mercado y asesoría experta.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="/catalogo"
          class="h-12 px-8 rounded-lg bg-primary hover:bg-primary-hover text-white font-bold transition-all shadow-lg shadow-primary/25 hover:shadow-primary/40 active:scale-95 flex items-center gap-2"
        >
          Ver Catálogo
          <span class="material-symbols-outlined text-[20px]"
            >arrow_forward</span
          >
        </a>
        <a
          href="/contactanos"
          class="h-12 px-8 rounded-lg bg-white/5 hover:bg-white/10 text-white font-semibold backdrop-blur-md border border-white/10 transition-all flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-[20px]">call</span>
          Contactar Asesor
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-6 pt-8 border-t border-white/10 mt-4">
        <div>
          <p class="text-2xl font-bold text-white">5k+</p>
          <p class="text-xs text-text-muted uppercase tracking-wide">
            Productos
          </p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white">120+</p>
          <p class="text-xs text-text-muted uppercase tracking-wide">Marcas</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white">28</p>
          <p class="text-xs text-text-muted uppercase tracking-wide">Años</p>
        </div>
      </div>
    </div>
  </div>
</section>

---
/**
 * Footer Component
 * Based on Stitch design assets
 */

import { BUSINESS, CONTACT, SOCIAL } from "../../config/site";

const currentYear = new Date().getFullYear();
---

<footer class="bg-footer-bg border-t border-white/10 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div
            class="flex items-center justify-center w-8 h-8 rounded bg-primary text-white"
          >
            <span class="material-symbols-outlined text-[18px]"
              >construction</span
            >
          </div>
          <span class="text-xl font-bold text-white">{BUSINESS.name}</span>
        </div>
        <p class="text-text-secondary text-sm leading-relaxed">
          {BUSINESS.description}
        </p>
        <div class="flex gap-4">
          <a
            href={SOCIAL.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary hover:text-white transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
          <a
            href={SOCIAL.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary hover:text-white transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.944 2.013 9.284 2 11.714 2h.601zm-.6 1.802h-.6c-2.356 0-2.692.01-3.645.052-.88.04-1.357.187-1.675.31a2.79 2.79 0 00-1.036.672 2.79 2.79 0 00-.673 1.036c-.123.318-.27.795-.31 1.675-.042.953-.052 1.289-.052 3.645v.6c0 2.356.01 2.692.052 3.645.04.88.187 1.357.31 1.675.161.413.374.754.673 1.036a2.79 2.79 0 001.036.673c.318.123.795.27 1.675.31.953.042 1.289.052 3.645.052h.6c2.356 0 2.692-.01 3.645-.052.88-.04 1.357-.187 1.675-.31a2.79 2.79 0 001.036-.673 2.79 2.79 0 00.673-1.036c.123-.318.27-.795.31-1.675.042-.953.052-1.289.052-3.645v-.6c0-2.356-.01-2.692-.052-3.645-.04-.88-.187-1.357-.31-1.675a2.79 2.79 0 00-.673-1.036 2.79 2.79 0 00-1.036-.673c-.318-.123-.795-.27-1.675-.31-.953-.042-1.289-.052-3.645-.052zm0 3.065a5.133 5.133 0 110 10.266 5.133 5.133 0 010-10.266zm0 8.465a3.332 3.332 0 100-6.664 3.332 3.332 0 000 6.664zm5.338-8.67a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
          <a
            href={SOCIAL.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary hover:text-white transition-colors"
            aria-label="TikTok"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-white font-bold mb-4">Categorías</h3>
        <ul class="space-y-2 text-sm text-text-secondary">
          <li>
            <a
              href="/catalogo?category=construccion"
              class="hover:text-primary transition-colors">Construcción</a
            >
          </li>
          <li>
            <a
              href="/catalogo?category=gasfiteria"
              class="hover:text-primary transition-colors">Gasfitería</a
            >
          </li>
          <li>
            <a
              href="/catalogo?category=electricidad"
              class="hover:text-primary transition-colors">Electricidad</a
            >
          </li>
          <li>
            <a
              href="/catalogo?category=pinturas"
              class="hover:text-primary transition-colors">Pinturas</a
            >
          </li>
          <li>
            <a
              href="/catalogo?category=ferreteria"
              class="hover:text-primary transition-colors">Ferretería</a
            >
          </li>
        </ul>
      </div>

      <!-- Customer Service -->
      <div>
        <h3 class="text-white font-bold mb-4">Atención al Cliente</h3>
        <ul class="space-y-2 text-sm text-text-secondary">
          <li>
            <a href="/nosotros" class="hover:text-primary transition-colors"
              >Sobre Nosotros</a
            >
          </li>
          <li>
            <a href="/contactanos" class="hover:text-primary transition-colors"
              >Contacto</a
            >
          </li>
          <li>
            <a href="/faq" class="hover:text-primary transition-colors"
              >Preguntas Frecuentes</a
            >
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold mb-4">Contacto</h3>
        <ul class="space-y-3 text-sm text-text-secondary">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-lg"
              >location_on</span
            >
            <span>{CONTACT.address.full}</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-lg"
              >call</span
            >
            <span>{CONTACT.phones[0]}</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-lg"
              >mail</span
            >
            <span>{CONTACT.emails[0]}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-sm text-text-muted">
        © {currentYear}
        {BUSINESS.legalName}. Todos los derechos reservados.
      </p>
      <div class="flex gap-6 text-sm text-text-muted">
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Términos</a>
      </div>
    </div>
  </div>
</footer>

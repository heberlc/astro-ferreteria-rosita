---
/**
 * SEO Component
 * Centralized meta tags, Open Graph, and Schema.org data
 */

import { BUSINESS, CONTACT, SITE, SOCIAL } from "../../config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: "website" | "product" | "article";
}

const {
  title = SITE.title,
  description = SITE.defaultDescription,
  image = SITE.ogImage,
  url = Astro.url.href,
  type = "website",
} = Astro.props;

// Schema.org LocalBusiness
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HardwareStore",
  name: BUSINESS.legalName,
  alternateName: BUSINESS.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  image: `${SITE.url}/storefront.jpg`,
  description: description,
  telephone: CONTACT.phonesFormatted,
  email: CONTACT.emails[0],
  address: {
    "@type": "PostalAddress",
    streetAddress: CONTACT.address.street,
    addressLocality: CONTACT.address.district.split(" - ")[1] || "Chorrillos",
    addressRegion: CONTACT.address.city,
    postalCode: "15067",
    addressCountry: "PE",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -12.168,
    longitude: -77.0085,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
      ],
      opens: "08:00",
      closes: "18:00",
    },
  ],
  priceRange: "$$",
  sameAs: [SOCIAL.facebook, SOCIAL.instagram],
};
---

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={BUSINESS.name} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${SITE.url}${image}`} />
<meta property="og:site_name" content={BUSINESS.name} />
<meta property="og:locale" content={SITE.locale} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={`${SITE.url}${image}`} />

<!-- Canonical -->
<link rel="canonical" href={url} />

<!-- Web Manifest -->
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#f96b06" />

<!-- Schema.org LocalBusiness -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(localBusinessSchema)}
/>

---
/**
 * Product Card Component
 * Reusable card for product display in catalog
 * Supports both local images (optimized with Astro Image) and external URLs
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { FEATURES } from "../../config/site";

interface Variant {
  name: string;
  sku: string;
  price: number;
}

interface Props {
  title: string;
  slug: string;
  brand: string;
  price?: number;
  originalPrice?: number;
  image: ImageMetadata | string;
  category: string;
  isNew?: boolean;
  discount?: number;
  stock?: boolean;
  rating?: number;
  reviewCount?: number;
  variants?: Variant[];
}

const {
  title,
  slug,
  brand,
  price,
  originalPrice,
  image,
  category,
  isNew = false,
  discount,
  stock = true,
  rating = 0,
  reviewCount = 0,
  variants,
} = Astro.props;

// Calculate display price (minimum from variants or base price)
const hasVariants = variants && variants.length > 0;
const displayPrice = hasVariants
  ? Math.min(...variants.map((v) => v.price))
  : price;

const badgeText = discount ? `-${discount}% OFF` : isNew ? "NUEVO" : null;
const badgeColor = discount ? "bg-red-600" : "bg-primary";

// Check if image is a local asset (ImageMetadata) or external URL (string)
const isLocalImage = typeof image !== "string";
const imageSrc = isLocalImage ? image : image;

// Calculate stars from rating
const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 >= 0.5;
const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
---

<div
  data-product={slug}
  data-brand={brand}
  data-price={displayPrice || 0}
  data-category={category}
  class={`group relative flex flex-col bg-surface-dark rounded-xl overflow-hidden border border-border-dark hover:border-primary transition-colors duration-300 shadow-lg hover:shadow-primary/10 ${!stock ? "opacity-75" : ""}`}
>
  <!-- Badge -->
  {
    badgeText && (
      <div
        class={`absolute top-3 left-3 z-10 ${badgeColor} text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider`}
      >
        {badgeText}
      </div>
    )
  }

  {
    !stock && (
      <div class="absolute top-3 left-3 z-10 bg-gray-700 text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">
        Agotado
      </div>
    )
  }

  <!-- Favorite Button -->
  <button
    class="absolute top-3 right-3 z-10 text-text-secondary hover:text-primary p-1.5 bg-background-dark/80 backdrop-blur rounded-full opacity-0 group-hover:opacity-100 transition-opacity"
  >
    <span class="material-symbols-outlined text-lg">favorite</span>
  </button>

  <!-- Image -->
  <a
    href={`/catalogo/${slug}`}
    class={`relative h-56 w-full bg-surface-elevated p-6 flex items-center justify-center overflow-hidden ${!stock ? "grayscale" : ""}`}
  >
    {
      isLocalImage ? (
        <Image
          src={imageSrc as ImageMetadata}
          alt={title}
          width={400}
          height={400}
          class="object-contain h-full w-full group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <img
          src={imageSrc as string}
          alt={title}
          class="object-contain h-full w-full group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      )
    }
  </a>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <!-- Rating -->
    {
      FEATURES.showProductReviews &&
        (rating > 0 ? (
          <div class="flex items-center gap-1 mb-2 text-yellow-500 text-sm">
            {Array.from({ length: fullStars }).map(() => (
              <span class="material-symbols-outlined text-base">star</span>
            ))}
            {hasHalfStar && (
              <span class="material-symbols-outlined text-base">star_half</span>
            )}
            {Array.from({ length: emptyStars }).map(() => (
              <span class="material-symbols-outlined text-base text-text-muted">
                star_border
              </span>
            ))}
            {reviewCount > 0 && (
              <span class="text-text-secondary text-xs ml-1">
                ({reviewCount})
              </span>
            )}
          </div>
        ) : (
          <div class="flex items-center gap-1 mb-2 text-text-muted text-sm">
            <span class="text-xs">Sin reseñas</span>
          </div>
        ))
    }

    <!-- Title -->
    <a href={`/catalogo/${slug}`}>
      <h3
        class="text-white font-semibold text-lg leading-tight mb-1 group-hover:text-primary transition-colors line-clamp-2"
      >
        {title}
      </h3>
    </a>
    <p class="text-text-secondary text-sm mb-4">{brand}</p>

    <!-- Price & CTA -->
    <div class="mt-auto flex items-end justify-between">
      <div class="flex flex-col">
        {
          originalPrice && (
            <span class="text-text-secondary text-xs line-through">
              S/{originalPrice.toFixed(2)}
            </span>
          )
        }
        {
          displayPrice ? (
            <>
              {hasVariants && (
                <span class="text-text-secondary text-xs">desde </span>
              )}
              <span class="text-white text-xl font-bold">
                S/{displayPrice.toFixed(2)}
              </span>
            </>
          ) : (
            <span class="text-text-secondary text-sm">Consultar precio</span>
          )
        }
      </div>

      {
        stock ? (
          hasVariants ? (
            // Products with variants: link to detail page to select variant
            <a
              href={`/catalogo/${slug}`}
              class="bg-primary sm:bg-border-dark hover:bg-primary-hover sm:hover:bg-primary text-white p-2.5 rounded-lg transition-colors flex items-center justify-center sm:group-hover:bg-primary"
              title="Ver opciones"
            >
              <span class="material-symbols-outlined">visibility</span>
            </a>
          ) : (
            // Products without variants: quick add to cart
            <button
              class="add-to-cart-btn bg-primary sm:bg-border-dark hover:bg-primary-hover sm:hover:bg-primary text-white p-2.5 rounded-lg transition-colors flex items-center justify-center sm:group-hover:bg-primary"
              data-slug={slug}
              data-title={title}
              data-brand={brand}
              data-price={displayPrice}
              data-image={isLocalImage ? (image as ImageMetadata).src : image}
            >
              <span class="material-symbols-outlined">add_shopping_cart</span>
            </button>
          )
        ) : (
          <button
            class="bg-border-dark text-white/50 cursor-not-allowed p-2.5 rounded-lg flex items-center justify-center"
            disabled
          >
            <span class="material-symbols-outlined">notifications</span>
          </button>
        )
      }
    </div>
  </div>
</div>

<script>
  import { addToCart } from "../../lib/cart";

  // Add to cart button handler
  document.querySelectorAll(".add-to-cart-btn").forEach((button) => {
    button.addEventListener("click", (e) => {
      const btn = e.currentTarget as HTMLButtonElement;

      addToCart({
        slug: btn.dataset.slug || "",
        title: btn.dataset.title || "",
        brand: btn.dataset.brand || "",
        price: btn.dataset.price ? parseFloat(btn.dataset.price) : undefined,
        image: btn.dataset.image || "",
      });

      // Visual feedback
      const icon = btn.querySelector(".material-symbols-outlined");
      if (icon) {
        icon.textContent = "check";
        setTimeout(() => {
          icon.textContent = "add_shopping_cart";
        }, 1000);
      }
    });
  });
</script>

---
/**
 * Filter Sidebar Component
 * Sidebar with category, price, and brand filters
 */

interface Props {
  currentCategory?: string;
}

const { currentCategory } = Astro.props;

const categories = [
  { slug: "construccion", name: "Construcción", count: 45 },
  { slug: "gasfiteria", name: "Gasfitería", count: 32 },
  { slug: "electricidad", name: "Electricidad", count: 28 },
  { slug: "pinturas", name: "Pinturas", count: 24 },
  { slug: "ferreteria", name: "Ferretería", count: 67 },
  { slug: "ceramicos", name: "Cerámicos", count: 18 },
];

const brands = ["Pavco", "Celima", "Truper", "Stanley", "Dewalt", "CPP"];
---

<aside class="hidden lg:flex flex-col w-72 shrink-0 gap-8 h-fit sticky top-28">
  <!-- Filter Header -->
  <div class="flex items-center justify-between">
    <h3 class="text-white text-lg font-bold">Filtros</h3>
    <a
      href="/catalogo"
      class="text-text-secondary text-sm hover:text-primary transition-colors"
      >Limpiar</a
    >
  </div>

  <!-- Categories -->
  <div class="flex flex-col gap-4">
    <h4 class="text-text-secondary text-xs font-bold uppercase tracking-wider">
      Categorías
    </h4>
    <div class="flex flex-col gap-2">
      {
        categories.map((cat) => (
          <a
            href={`/catalogo?category=${cat.slug}`}
            class={`group flex items-center gap-3 p-3 rounded-lg border transition-all cursor-pointer ${
              currentCategory === cat.slug
                ? "border-primary/50 bg-surface-dark"
                : "border-border-dark bg-transparent hover:border-border-dark hover:bg-surface-dark"
            }`}
          >
            <span
              class={`text-sm font-medium transition-colors ${
                currentCategory === cat.slug
                  ? "text-white"
                  : "text-text-secondary group-hover:text-white"
              }`}
            >
              {cat.name}
            </span>
            <span class="ml-auto text-xs text-text-secondary bg-border-dark px-2 py-0.5 rounded-full">
              {cat.count}
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- Price Range -->
  <div class="flex flex-col gap-4">
    <h4 class="text-text-secondary text-xs font-bold uppercase tracking-wider">
      Rango de Precio
    </h4>
    <div class="flex items-center gap-4 text-white text-sm">
      <div
        class="bg-surface-dark rounded border border-border-dark px-3 py-2 flex-1"
      >
        S/0
      </div>
      <span class="text-text-secondary">-</span>
      <div
        class="bg-surface-dark rounded border border-border-dark px-3 py-2 flex-1"
      >
        S/500
      </div>
    </div>
    <div class="relative h-1 w-full bg-border-dark rounded-full mt-2">
      <div class="absolute left-0 top-0 h-full w-1/2 bg-primary rounded-full">
      </div>
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 size-4 bg-white border-2 border-primary rounded-full shadow cursor-pointer hover:scale-110 transition-transform"
      >
      </div>
    </div>
  </div>

  <!-- Brands -->
  <div class="flex flex-col gap-3">
    <h4 class="text-text-secondary text-xs font-bold uppercase tracking-wider">
      Marcas
    </h4>
    <div class="flex flex-col gap-2">
      {
        brands.map((brand) => (
          <label class="flex items-center gap-3 cursor-pointer group">
            <input
              type="checkbox"
              class="rounded border-border-dark bg-surface-dark text-primary focus:ring-0 focus:ring-offset-0"
            />
            <span class="text-sm text-text-secondary group-hover:text-white transition-colors">
              {brand}
            </span>
          </label>
        ))
      }
    </div>
  </div>
</aside>
